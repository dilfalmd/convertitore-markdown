{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convertitore Markdown",
  "version": "0.1.0",
  "identifier": "io.github.convertitore-markdown",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Convertitore Markdown",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'; base-uri 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Converte documenti in Markdown",
    "copyright": "Copyright (C) Diletta Falcone",
    "license": "AGPL-3.0-or-later",
    "externalBin": [
      "binaries/convertitore-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
